# Postgres connection string จาก Supabase
# Project Settings > Database > Connection string (Pooler)
# ใช้รูปแบบ host: aws-0-<region>.pooler.supabase.com (เชื่อมผ่าน IPv4)
# - 5432 = session pooler (เหมาะกับ prisma db push / migrate)
# - 6543 = transaction pooler (ใส่ ?pgbouncer=true)
# ต้องเข้ารหัสอักขระพิเศษในรหัสผ่าน เช่น ! = %21, ? = %3F
DATABASE_URL=postgresql://postgres.<project-ref>:<DB_PASSWORD-encoded>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ใช้สำหรับเข้ารหัส session cookie ของแอดมิน (สุ่มยาว ๆ อย่างน้อย 32 ตัวอักษร)
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Cloudflare R2 (สำหรับเก็บรูปภาพและไฟล์ทั้งหมดของเว็บ)
# Cloudflare Dashboard > R2 > Manage R2 API Tokens > Create API Token (Object Read & Write)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=<bucket-name>
R2_ACCESS_KEY_ID=<access-key-id>
R2_SECRET_ACCESS_KEY=<secret-access-key>
# ถ้ามี custom domain หรือ r2.dev public URL ให้ใส่ URL ฐาน (เช่น https://cdn.example.com)
# ถ้าเว้นว่าง ระบบจะ serve ไฟล์ผ่านตัวเว็บเองที่ /r2/<key> (ไม่ต้องเปิด bucket เป็น public)
R2_PUBLIC_URL=